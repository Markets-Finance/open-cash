---
import { isDevAuth } from "shared";
import Mark from "../Mark.astro";
---

<div class="gate" data-gate>
  <section class="gate__stage" aria-hidden="true">
    <span class="gate__brand"><Mark />open<em>cash</em></span>
    <div class="gate__lines"><i></i><i></i><i></i><i></i></div>
    <Mark class="gate__logo" />
    <small class="gate__legal">© OpenCash 2026</small>
  </section>
  <section class="gate__panel">
    <div class="gate__card">
      {isDevAuth && <div class="gate__top"><span class="gate__dev">Dev mode · test account</span></div>}
      <form class="gate__form" data-gate-form>
        <h1 class="gate__title" data-gate-title>Sign in</h1>
        <p class="gate__hint" data-gate-hint>Use your passkey.</p>
        <div class="gate__fields" data-gate-fields hidden>
          <label class="gfield"><span>Name</span><input name="name" type="text" autocomplete="name" placeholder="Ada Lovelace" /></label>
          <label class="gfield"><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="ada@example.com" /></label>
        </div>
        <div class="gate__fields" data-gate-import-block hidden>
          <label class="gfield gfield--check"><input type="checkbox" data-gate-import-toggle /> <span>I already have a wallet to bring in</span></label>
          <div data-gate-import-fields hidden>
            <label class="gfield"><span>Private key</span><input name="importKey" type="password" autocomplete="off" spellcheck="false" placeholder="0x… (64 hex characters)" /></label>
            <p class="gate__hint" data-gate-import-preview></p>
            <p class="gate__hint">The key is encrypted with your new passkey and stays on this device. It is never sent anywhere.</p>
          </div>
        </div>
        <div class="gate__missing" data-gate-missing hidden>
          <b>No passkey found</b>
          <p>There is no OpenCash passkey on this device, or the prompt was closed. Create an account, or import a wallet you already have.</p>
        </div>
        <p class="gate__status" data-gate-status role="status"></p>
        <div class="gate__actions">
          <button type="submit" class="gate__go" data-gate-go>Sign in</button>
          <button type="button" class="gate__secondary" data-gate-import>Import a wallet</button>
          <button type="button" class="gate__secondary" data-gate-switch>Create an account</button>
        </div>
      </form>
    </div>
  </section>
</div>
