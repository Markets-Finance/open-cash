---
import AccountCard from "../AccountCard.astro";
---

<section class="panel" data-panel="account" hidden>
  <div class="account-layout">
    <div class="account-layout__card" data-card-slot><AccountCard tier="Trader" /></div>
    <div class="account-layout__actions">
      <div data-acct-home>
      <p class="account-group__label">Account settings</p>
      <div class="account-group" role="list">
        <button type="button" class="setting-row" data-acct-open="profile">
          <span class="setting-row__icon setting-row__icon--violet"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7z"/></svg></span>
          <span class="setting-row__label">Profile</span><span class="setting-row__chev" aria-hidden="true">›</span>
        </button>
        <button type="button" class="setting-row" data-acct-open="x">
          <span class="setting-row__icon setting-row__icon--lime"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke-width="3" fill="none"/></svg></span>
          <span class="setting-row__label">Verified X account</span><span class="setting-row__chev" aria-hidden="true">›</span>
        </button>
        <button type="button" class="setting-row" data-acct-open="limits">
          <span class="setting-row__icon setting-row__icon--lime"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" stroke-width="2" fill="none"/></svg></span>
          <span class="setting-row__label">Loss limits</span><span class="setting-row__chev" aria-hidden="true">›</span>
        </button>
        <button type="button" class="setting-row" data-acct-open="wallet">
          <span class="setting-row__icon setting-row__icon--blue"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="3"/><rect x="5" y="4" width="11" height="5" rx="2" opacity=".55"/></svg></span>
          <span class="setting-row__label">Wallet address</span><span class="setting-row__chev" aria-hidden="true">›</span>
        </button>
      </div>

      <p class="account-group__label">Settings</p>
      <div class="account-group" role="list">
        <button type="button" class="setting-row" data-acct-open="network">
          <span class="setting-row__icon setting-row__icon--blue"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke-width="2.4"/><ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke-width="2"/><path d="M3 12h18" stroke-width="2"/></svg></span>
          <span class="setting-row__label">Network</span><span class="setting-row__value">Hyperliquid Testnet</span><span class="setting-row__chev" aria-hidden="true">›</span>
        </button>
        <button type="button" class="setting-row" data-sign-out>
          <span class="setting-row__icon setting-row__icon--peach"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5" fill="none" stroke-width="2.6"/><path d="M9 12h11M16 8l4 4-4 4" fill="none" stroke-width="2.6"/></svg></span>
          <span class="setting-row__label">Sign out</span><span class="setting-row__chev" aria-hidden="true">›</span>
        </button>
      </div>

      </div>

      <div class="card acct-page" data-acct-pane="profile" hidden>
        <div class="acct-page__head"><button type="button" class="back-btn" data-acct-back><span aria-hidden="true">←</span> Account</button><span class="acct-page__title">Profile</span></div>
        <label class="field"><span>Name</span><input type="text" data-profile-name placeholder="Trader" /></label>
        <label class="field"><span>Email</span><input type="email" data-profile-email placeholder="you@domain.com" /></label>
        <div class="btn-row">
          <button type="button" class="btn btn--primary" data-save-profile>Save profile</button>
          <button type="button" class="btn" data-shuffle>Shuffle avatar</button>
        </div>
      </div>


      <div class="card acct-page" data-x-card data-acct-pane="x" hidden>
        <div class="acct-page__head"><button type="button" class="back-btn" data-acct-back><span aria-hidden="true">←</span> Account</button><span class="acct-page__title">Verified X account</span></div>
        <p class="agent__hint" data-x-status>Prove this address is yours on X. It adds your handle to leaderboards.</p>
        <form class="bots__form" data-x-form>
          <input type="text" data-x-handle autocomplete="off" placeholder="@yourhandle" />
          <button type="submit" class="btn btn--primary">Get proof</button>
        </form>
        <div data-x-step hidden>
          <p class="bots__note">1. Post this exactly as it is. 2. Paste the link to your post.</p>
          <textarea data-x-text readonly rows="5"></textarea>
          <div class="bots__form">
            <a class="btn" data-x-post target="_blank" rel="noreferrer">Post on X</a>
            <input type="text" data-x-url autocomplete="off" placeholder="https://x.com/you/status/…" />
            <button type="button" class="btn btn--primary" data-x-verify>Verify</button>
          </div>
        </div>
      </div>

      <div class="card acct-page" data-acct-pane="limits" hidden>
        <div class="acct-page__head"><button type="button" class="back-btn" data-acct-back><span aria-hidden="true">←</span> Account</button><span class="acct-page__title">Loss limits</span></div>
        <p class="agent__hint">New trades are paused once you lose your daily limit, and every new trade must have a defined maximum loss. Closing is always allowed.</p>
        <label class="field"><span>Daily loss limit (USD)</span><input type="number" min="1" step="any" data-guard-daily /></label>
        <label class="field"><span>Most to risk on one trade (USD)</span><input type="number" min="1" step="any" data-guard-trade /></label>
        <label class="field"><span>Pause for (minutes) after a breach</span><input type="number" min="5" step="1" data-guard-cooloff /></label>
        <p class="agent__hint" data-guard-bounds></p>
        <p class="agent__hint" data-guard-note></p>
        <button type="button" class="btn btn--primary" data-guard-save>Save with my passkey</button>
        <p class="status-line" data-guard-status></p>
      </div>

      <div class="card acct-page" data-acct-pane="wallet" hidden>
        <div class="acct-page__head"><button type="button" class="back-btn" data-acct-back><span aria-hidden="true">←</span> Account</button><span class="acct-page__title">Wallet address</span></div>
        <span class="card__label">Your account address</span>
        <p class="account-address" data-wallet-address>—</p>
        <div class="btn-row"><button type="button" class="btn" data-copy-address>Copy address</button></div>
        <p class="agent__hint">One passkey, one address. Deposits go through the app, not straight to this address.</p>
      </div>

      <div class="card acct-page" data-acct-pane="network" hidden>
        <div class="acct-page__head"><button type="button" class="back-btn" data-acct-back><span aria-hidden="true">←</span> Account</button><span class="acct-page__title">Network</span></div>
        <span class="card__label">Network</span>
        <p class="account-address">Hyperliquid Testnet · chain 10143</p>
        <p class="agent__hint">Trading runs on the Hyperliquid testnet exchange. Testnet funds have no value.</p>
      </div>

      <p class="account-status" data-account-status role="status"></p>
    </div>
  </div>
</section>
