<section class="lab" data-lab>
  <header class="lab__head">
    <div class="lab__title">
      <span class="panel__label">Strategies</span>
      <h2>Pick one. See what it would have done.</h2>
    </div>
    <button type="button" class="btn lab__trade" data-lab-trade data-open-asset="BTC">Trade BTC ↗</button>
    <div class="seg" role="group" aria-label="Candle size">
      <button type="button" class="seg__btn" data-lab-frame="3600" aria-pressed="true">1h</button>
      <button type="button" class="seg__btn" data-lab-frame="14400" aria-pressed="false">4h</button>
      <button type="button" class="seg__btn" data-lab-frame="86400" aria-pressed="false">1d</button>
    </div>
    <div class="seg" role="group" aria-label="History length">
      <button type="button" class="seg__btn" data-lab-days="30" aria-pressed="true">30D</button>
      <button type="button" class="seg__btn" data-lab-days="90" aria-pressed="false">90D</button>
      <button type="button" class="seg__btn" data-lab-days="180" aria-pressed="false">180D</button>
      <button type="button" class="seg__btn" data-lab-days="365" aria-pressed="false">1Y</button>
    </div>
  </header>
  <div class="chip-row" data-lab-markets></div>
  <p class="lab__note" data-lab-state></p>
  <div class="lab__tiles" data-lab-tiles></div>
  <div class="lab__detail" data-lab-detail hidden></div>
</section>
