---
import { footerLinks, site } from "../../data/site";
import Mark from "../Mark.astro";
---

<footer class="site-footer">
  <div class="footer-top">
    <a class="wordmark" href="#home"><Mark />open<span>cash</span></a>
    <p>Trade Hyperliquid perps by theme or by rule. Test first, then cap the spend.</p>
    <div>{footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}</div>
  </div>
  <div class="footer-statement">Strategy layer<br /><span>of Hyperliquid.</span></div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} OpenCash</span><span>Early access · {site.network}</span><a href="#home">Back to top ↑</a>
  </div>
</footer>
