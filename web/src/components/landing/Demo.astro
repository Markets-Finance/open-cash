---
import { demoSteps } from "../../data/landing";
---

<section class="demo-section section-frame" id="explore" aria-labelledby="demo-title">
  <div class="section-heading">
    <h2 id="demo-title">See a position form.<br />Make the next move.</h2>
    <p>A small, interactive look at the terminal we’re building. Walk a sample bin from a pick to a capped run.</p>
  </div>
  <div class="demo-workspace" data-demo={JSON.stringify(demoSteps)}>
    <div class="demo-summary">
      <span class="small-label"><i class="status-dot"></i> INTERACTIVE DEMO</span>
      <h3>OpenCash Sample Bin</h3>
      <p>Illustrative basket · No funds or transactions are sent.</p>
      <div class="demo-asset-mark" aria-hidden="true">
        <svg viewBox="0 0 200 200"><path d="m100 20 80 45v75l-80 45-80-45V65Zm0 0v80m-80-35 80 35 80-35m-80 35v85m-80-45 80-40 80 40"></path></svg>
      </div>
      <span class="demo-caption">A CLEAR PATH FROM IDEA TO POSITION</span>
    </div>
    <div class="demo-flow">
      <ol class="workflow-steps">
        {demoSteps.map((step, i) => (
          <li data-demo-step={i} class={i === 0 ? "current" : ""}>
            <span class="step-number">0{i + 1}</span>
            <span>{step.name}</span>
            <span class="step-state">{i === 0 ? "Ready" : "Upcoming"}</span>
          </li>
        ))}
      </ol>
      <div class="demo-next">
        <p id="demo-description" aria-live="polite">{demoSteps[0].description}</p>
        <button class="dark-button" id="demo-advance">
          <span>{demoSteps[0].next}</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg>
        </button>
        <button class="reset-button" id="demo-reset">Reset demo</button>
      </div>
    </div>
  </div>
</section>
