---
import { site } from "../../data/site";
import { binById } from "shared";
import { agentRows, features, strategyRows, surfaces } from "../../data/landing";
import Mark from "../Mark.astro";
const showcase = ["trump-lovers", "ai-lovers", "vitaliks-enemies"].map((id) => binById(id)!);
---

<section class="applications section-frame" id="assets" aria-labelledby="applications-title">
  <div class="section-heading">
    <h2 id="applications-title">Trade a market.<br />Or a whole narrative.</h2>
    <p>Our bins turn a whole narrative into one position: Trump lovers, AI lovers, Vitalik's enemies, memory chips, oil shock. Pick one, size it, and every leg opens on Hyperliquid in one tap.</p>
  </div>
  <div class="feature-grid">
    {features.map((feature, i) => (
      <article class={`feature feature-${feature.id}`}>
        <div class="feature-visual" aria-hidden="true">
          {feature.visual === "bin" && <div class="bin-stack">{showcase.map((bin) => <div class="floating-bin"><span class="coin">▦</span><div><b>{bin.name}</b><small>{bin.legs.map((leg) => `${leg.direction === "short" ? "−" : ""}${leg.symbol.split(":").pop()}`).join(" · ")}</small></div><span>↗</span></div>)}</div>}
          {feature.visual === "activity" && <div class="activity"><small>Strategies</small>{strategyRows.map((name) => <div><b>{name}</b><span>Rules ↗<small>Test first</small></span></div>)}</div>}
          {feature.visual === "agent" && <div class="activity"><small>Agent</small>{agentRows.map(([who, line]) => <div><b>{who}</b><span>{line}</span></div>)}</div>}
          {feature.visual === "paper" && <div class="fund-preview"><small>Paper mode</small><strong>Test it first.</strong><span>Real history. Fake money. ↗</span></div>}
          {feature.visual === "cap" && <div class="leverage-preview"><small>Loss limit</small><strong>Size the risk.</strong><div class="slider-track"><i></i></div><span>Optional, set by you</span></div>}
          {feature.visual === "rank" && <div class="margin-card"><div><Mark /><span>open cash</span></div><small>LEADERBOARD</small><strong>Ranked on-chain.</strong><span>Verified users can copy.</span></div>}
          {feature.visual === "passkey" && <div class="passkey-icon"><svg viewBox="0 0 80 80"><path d="M24 13H13v11m43-11h11v11M13 56v11h11m43-11v11H56M28 33v7m24-7v7M28 49q12 14 24 0" /></svg></div>}
        </div>
        <div class="feature-copy"><span class="feature-number">0{i + 1}</span><div><h3>{feature.title}</h3><p>{feature.text}</p></div></div>
      </article>
    ))}
  </div>
  <p class="section-footnote">Live on {site.network}.</p>
  <div class="trading-details">
    {surfaces.map((surface) => (
      <details name="trading-surfaces">
        <summary>{surface.tab}<span aria-hidden="true">+</span></summary>
        <div class="trading-details-content">
          <div><span class="small-label">{surface.audience}</span><p>{surface.label}</p><a class="text-link" href="#explore">Explore the flow <span aria-hidden="true">↗</span></a></div>
          <dl>{surface.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
        </div>
      </details>
    ))}
  </div>
</section>
