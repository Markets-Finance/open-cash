---
import LaunchLink from "./LaunchLink.astro";
---

<section class="closing" id="waitlist" aria-labelledby="closing-title">
  <div class="closing-content">
    <h2 id="closing-title">Every market.<br />One call.</h2>
    <p class="closing-lede">OpenCash is in early access on Monad testnet. Leave an email and you'll be told when the terminal opens up.</p>
    <LaunchLink class="light-button">Sign in with passkey <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg></LaunchLink>
    <form class="waitlist" id="waitlist-form" method="post" action="/waitlist">
      <label class="visually-hidden" for="waitlist-email">Email address</label>
      <input id="waitlist-email" name="email" type="email" required autocomplete="email" placeholder="you@domain.com" />
      <button class="light-button" type="submit">Join waitlist <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg></button>
    </form>
    <p class="waitlist-status" id="waitlist-status" role="status"></p>
  </div>
</section>
