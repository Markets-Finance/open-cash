    </>
  )}
  {kind === "bins" && (
    <>
      <path d="m120 43 83 43-83 44-83-44z" />
      <path d="m37 115 83 44 83-44M37 145l83 44 83-44" />
      <path class="object-detail" d="M120 130v59M37 86v59m166-59v59" />
      <path d="m85 68 82 44m-12-44-82 44" />
    </>
  )}
  {kind === "limits" && (
    <>
