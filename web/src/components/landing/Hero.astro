---
import LaunchLink from "./LaunchLink.astro";
import ProductFolder from "./ProductFolder.astro";
---

<section id="home" class="hero">
  <h1>Love It. Cash It<br />Trade the Open Markets</h1>
  <ProductFolder />
  <p>Pick a theme or a rule-based strategy, or tell the agent a trade in one line. Test it on real Hyperliquid history and with fake money, then run it under a hard spending cap. On Hyperliquid, on your phone and the web.</p>
  <LaunchLink class="light-button">Launch app <span aria-hidden="true">↗</span></LaunchLink>
</section>
