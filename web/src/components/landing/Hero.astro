---
import { site } from "../../data/site";
import LaunchLink from "./LaunchLink.astro";
import ProductFolder from "./ProductFolder.astro";
---

<section id="home" class="hero">
  <h1>Love It. Cash It<br />Trade the Open Markets</h1>
  <ProductFolder />
  <p>OpenCash is the strategy layer of Hyperliquid. Pick a themed bin or a rule-based strategy, or tell the agent a trade in one line. Test it on real Hyperliquid history and with fake money, then run it live with your own loss limits. On your phone and the web.</p>
  <div class="cta-row">
    <LaunchLink class="light-button">Launch app <span aria-hidden="true">↗</span></LaunchLink>
    <a class="light-button button-outline" href={site.androidApkUrl} download>Download for Android <span aria-hidden="true">↓</span></a>
  </div>
</section>
