---
import AgentPanel from "../components/dashboard/AgentPanel.astro";
import AnalyticsPanel from "../components/dashboard/AnalyticsPanel.astro";
import AccountPanel from "../components/dashboard/AccountPanel.astro";
import BinsPanel from "../components/dashboard/BinsPanel.astro";
import Gate from "../components/dashboard/Gate.astro";
import HomePanel from "../components/dashboard/HomePanel.astro";
import Modal from "../components/dashboard/Modal.astro";
import Topbar from "../components/dashboard/Topbar.astro";
import TradePanel from "../components/dashboard/TradePanel.astro";
import "../styles/landing.css";
import "../styles/system.css";
import "../styles/dashboard/shell.css";
import "../styles/dashboard/gate.css";
import "../styles/dashboard/home.css";
import "../styles/dashboard/theme.css";
import "../styles/dashboard/components.css";
import "../styles/dashboard/agent.css";
import "../styles/dashboard/bots.css";
import "../styles/dashboard/lab.css";
import "../styles/dashboard/analytics.css";
import "../styles/dashboard/revamp.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard · OpenCash</title>
  </head>
  <body>
    <Gate />
    <div class="dash" data-dash data-tab="home" hidden>
      <Topbar />
      <main class="dash__content">
        <HomePanel />
        <AgentPanel />
        <BinsPanel />
        <TradePanel />
        <AnalyticsPanel />
        <AccountPanel />
      </main>
    </div>
    <Modal />
    <script>
      import "../scripts/dashboard/index";
    </script>
  </body>
</html>
