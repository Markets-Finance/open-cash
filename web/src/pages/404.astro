---
import Mark from "../components/Mark.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Page not found · OpenCash</title>
  </head>
  <body>
    <main class="lost">
      <video
        class="lost__video"
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260801_001207_ec20d138-aa45-4b2b-ab8c-bdc71607f240.mp4"
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
      ></video>
      <div class="lost__brand" aria-label="OpenCash">
        <Mark class="lost__mark" />
        <span class="lost__wordmark" aria-hidden="true">open<span>cash</span></span>
      </div>
      <div class="lost__content">
        <h1 class="lost__code">404</h1>
        <div class="lost__rule" aria-hidden="true"></div>
        <p class="lost__message">The path may be broken, but the journey isn't. Let's get you back.</p>
      </div>
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Geist Mono:SemiBold";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("https://static.figma.com/font/GeistMono_wght__1") format("woff2");
  }

  @font-face {
    font-family: "DM Sans";
    src: url("../assets/fonts/dm-sans.woff2") format("woff2");
    font-weight: 100 1000;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    background: #000;
    overflow-x: hidden;
  }

  .lost {
    position: relative;
    min-height: 100svh;
    overflow-x: hidden;
    background: #000;
  }

  .lost__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    z-index: 0;
  }

  .lost__brand {
    position: absolute;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 233px;
    height: 40px;
    color: #fff;
  }

  .lost__mark {
    flex: none;
    width: 40px;
    height: 40px;
  }

  .lost__wordmark {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    font-family: "DM Sans", sans-serif;
    font-size: 34px;
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .lost__wordmark span {
    font-size: 18px;
    font-weight: 350;
    letter-spacing: -0.025em;
    margin-bottom: 3px;
  }

  .lost__content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    width: 483px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 44px;
    text-align: center;
  }

  .lost__code {
    margin: 0;
    padding-bottom: 0.12em;
    font-family: "Geist Mono:SemiBold", monospace;
    font-size: 295.751px;
    font-weight: 600;
    font-style: normal;
    line-height: 1.1;
    letter-spacing: -24.6459px;
    text-align: center;
    background: linear-gradient(247.3282658084845deg, rgb(255, 255, 255) 2.5334%, rgba(255, 255, 255, 0.4) 93.612%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lost__rule {
    width: 425px;
    height: 1px;
    background: #fff;
  }

  .lost__message {
    width: 100%;
    margin: 0;
    font-family: "Geist Mono:SemiBold", monospace;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -2px;
    color: #fff;
    text-align: center;
  }

  @media (max-width: 640px) {
    .lost__brand {
      top: 32px;
      transform: translateX(-50%) scale(0.75);
      transform-origin: center top;
    }

    .lost__content {
      width: min(100% - 40px, 360px);
      gap: 28px;
    }

    .lost__code {
      height: auto;
      min-height: 0;
      padding-bottom: 0.14em;
      font-size: clamp(140px, 52vw, 200px);
      letter-spacing: -0.09em;
    }

    .lost__rule {
      width: 100%;
    }

    .lost__message {
      font-size: clamp(16px, 4.5vw, 20px);
      letter-spacing: -1.3px;
    }
  }
</style>
